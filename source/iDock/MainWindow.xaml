<Window x:Class="iDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:iDock"
        Title="{x:Static local:ProductInfo.DisplayName}"
        Width="900" Height="680" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#101318" Foreground="#EEF2F7"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#9EAAB8" />
        <SolidColorBrush x:Key="Accent" Color="#A7EDCF" />
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1F27" />
            <Setter Property="BorderBrush" Value="#2A323D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#29333F" />
            <Setter Property="Foreground" Value="#EEF2F7" />
            <Setter Property="BorderBrush" Value="#3A4654" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.38" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A7EDCF" />
            <Setter Property="Foreground" Value="#14251E" />
            <Setter Property="BorderBrush" Value="#A7EDCF" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Background" Value="#273C34" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="BrandTitle" Text="{x:Static local:ProductInfo.DisplayName}" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Mirroring dan kontrol iPhone/iPad di Windows." Foreground="{StaticResource MutedText}" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#302B20" BorderBrush="#55482C" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right">
                    <TextBlock Text="EKSPERIMENTAL" FontSize="10" FontWeight="SemiBold" Foreground="#E7C789" />
                </Border>
            </StackPanel>
            <Button x:Name="StopButton" Grid.Column="2" Content="Hentikan sesi" IsEnabled="False" Click="Stop_Click" Padding="12,8" Margin="20,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="01  /  Layar perangkat" Style="{StaticResource SectionHeading}" />
                            <TextBlock Grid.Row="1" Text="Tampilkan layar perangkat melalui AirPlay. Jendela video UxPlay dapat diletakkan di samping aplikasi Windows Anda." Style="{StaticResource BodyText}" />
                            <TextBlock x:Name="MirrorStatus" Grid.Row="3" Text="Belum dimulai" Foreground="{StaticResource Accent}" Margin="0,20,0,12" />
                            <Button x:Name="MirrorButton" Grid.Row="4" Content="Buka mirroring" Style="{StaticResource PrimaryButton}" Click="Mirror_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="02  /  Mouse &amp; keyboard" Style="{StaticResource SectionHeading}" />
                            <TextBlock Grid.Row="1" Text="Kontrol melalui Bluetooth HID dan AssistiveTouch. Pasangkan perangkat setelah mengaktifkan kontrol; kompatibilitas adapter perlu diperiksa." Style="{StaticResource BodyText}" />
                            <TextBlock x:Name="ControlStatus" Grid.Row="3" Text="Belum terhubung" Foreground="{StaticResource Accent}" Margin="0,20,0,12" />
                            <WrapPanel Grid.Row="4">
                                <Button x:Name="ControlButton" Content="Aktifkan kontrol" Click="Control_Click" Margin="0,0,8,8" />
                                <Button x:Name="DiagnoseButton" Content="Cek Bluetooth" Click="Diagnose_Click" Padding="12,10" Margin="0,0,0,8" />
                            </WrapPanel>
                            <Border Grid.Row="5" BorderBrush="#2A323D" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="ResetSensitivityButton" DockPanel.Dock="Right" Content="Reset" Click="ResetSensitivity_Click" Padding="9,4" FontSize="11" Margin="8,0,0,0" AutomationProperties.Name="Reset sensitivitas ke 1 kali" />
                                        <TextBlock x:Name="SensitivityValue" DockPanel.Dock="Right" Text="1.00×" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                        <TextBlock Text="Sensitivitas pointer" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                                    </DockPanel>
                                    <Slider x:Name="SensitivitySlider" Minimum="0.25" Maximum="3" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25" IsMoveToPointEnabled="True" ValueChanged="Sensitivity_Changed" Margin="0,10,0,4" Foreground="{StaticResource Accent}" AutomationProperties.Name="Sensitivitas gerakan pointer perangkat" ToolTip="0.25× lebih pelan · 1.00× normal · 3.00× lebih cepat" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="3.00× · Cepat" FontSize="10" Foreground="{StaticResource MutedText}" />
                                        <TextBlock Text="0.25× · Pelan" FontSize="10" Foreground="{StaticResource MutedText}" />
                                    </DockPanel>
                                    <TextBlock x:Name="SensitivityStatus" Text="Tersimpan otomatis · klik dan scroll tetap." FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,8,0,0" />
                                    <TextBlock Text="Orientasi kontrol" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6" />
                                    <ComboBox x:Name="OrientationCombo" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="Orientation_Changed" Padding="8,5" Foreground="#14251E" Background="#E7EFEB" HorizontalContentAlignment="Left" AutomationProperties.Name="Orientasi arah gerakan pointer perangkat">
                                        <ComboBoxItem Content="Portrait · posisi normal" Tag="0" />
                                        <ComboBoxItem Content="Landscape · sisi atas di kiri" Tag="90" />
                                        <ComboBoxItem Content="Landscape · sisi atas di kanan" Tag="270" />
                                        <ComboBoxItem Content="Portrait terbalik · sisi atas di bawah" Tag="180" />
                                    </ComboBox>
                                    <TextBlock Text="Acuan: sisi atas saat portrait · belum otomatis." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Background="#182A25" BorderBrush="#2C453B" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,16,0,16">
                    <WrapPanel>
                        <TextBlock Margin="0,0,24,3"><Run FontWeight="SemiBold" Foreground="#BEF4DD" Text="Ctrl + D + C"/><Run Foreground="#B2C4BD" Text="  alihkan target input"/></TextBlock>
                        <TextBlock Margin="0,0,0,3"><Run FontWeight="SemiBold" Foreground="#BEF4DD" Text="Ctrl + Alt + Q"/><Run Foreground="#B2C4BD" Text="  kembalikan input ke Windows"/></TextBlock>
                    </WrapPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="03  /  Penyiapan koneksi" Style="{StaticResource SectionHeading}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" /></Border>
                            <TextBlock Grid.Column="1" Text="Hubungkan iPhone/iPad dan laptop ke Wi-Fi yang sama, lalu klik Buka mirroring." Style="{StaticResource BodyText}" Margin="0,1,0,12" />
                            <Border Grid.Row="1" Style="{StaticResource StepNumber}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,1,0,12"><Run Text="Di perangkat: Control Center → Screen Mirroring → " /><Run Text="uxplay-windows" Foreground="#EEF2F7" FontWeight="SemiBold" /><Run Text="." /></TextBlock>
                            <Border Grid.Row="2" Style="{StaticResource StepNumber}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" /></Border>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,1,0,0">
                                <TextBlock Text="Klik Aktifkan kontrol. Di perangkat, buka Settings → Accessibility → Touch → AssistiveTouch. Aktifkan, lalu buka Devices → Bluetooth Devices dan pilih laptop berikut. Setelah tersambung, tekan Ctrl + D + C untuk mengalihkan input." Style="{StaticResource BodyText}" />
                                <TextBlock x:Name="DeviceNameLabel" Text="Memuat nama laptop…" Foreground="#EEF2F7" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="#2A323D" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                            <TextBlock Text="Mirroring dan kontrol tidak memerlukan Mac atau aplikasi pendamping di perangkat. UxPlay mungkin meminta pemasangan layanan Bonjour saat pertama digunakan. Build dan signing aplikasi iOS tetap memerlukan toolchain terpisah." Style="{StaticResource BodyText}" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Status sesi" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="DiagnosticStatus" Text="Siap. Mulai dari mirroring, lalu cek koneksi Bluetooth." Style="{StaticResource BodyText}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="OpenLogsButton" Grid.Column="1" Content="Buka log" Click="OpenLogs_Click" Padding="12,7" VerticalAlignment="Top" />
                        </Grid>
                        <TextBox x:Name="LogBox" Height="118" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Background="#10151B" Foreground="#BAC7D6" BorderBrush="#2A323D" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="11" Padding="10" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Eksperimental · Kompatibilitas bergantung pada perangkat, versi iOS/iPadOS, dan adapter Bluetooth. Dukungan iPad belum diverifikasi." TextWrapping="Wrap" Foreground="#82909F" FontSize="11" Margin="2,14,0,4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
