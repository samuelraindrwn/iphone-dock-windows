<ui:FluentWindow x:Class="BleHid.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:BleHid.App.Views"
                 Title="BLE HID"
                 Width="960" Height="680"
                 MinWidth="720" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="BLE HID">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="Bluetooth24" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="1"
                       PaneDisplayMode="Left"
                       OpenPaneLength="220"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="True">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Status" TargetPageType="{x:Type views:StatusPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Info24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="Hosts" TargetPageType="{x:Type views:HostsPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Bluetooth24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="Capture" TargetPageType="{x:Type views:CapturePage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Keyboard24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>

      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type views:SettingsPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Settings24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>
